    {
      "id": "consumer-checkout-selected-product",
      "profile": "consumer",
      "category": "arguments",
      "prompt": "I chose application app_test_shop product prod_test_tote at its standard price price_test_standard, quantity 2, delivered to Ghana. Create the checkout using operation key op_test_checkout_001.",
      "fixture": {
        "tool_results": [
          {
            "name": "get_product",
            "result": {
              "product": {
                "application_id": "app_test_shop",
                "id": "prod_test_tote",
                "default_price_id": "price_test_standard"
              }
            }
          },
          {
            "name": "create_checkout",
            "result": {
              "checkout": {
                "status": "ready",
                "url": "https://checkout.inttegro.invalid/test"
              }
            }
          }
        ]
      },
      "expectation": {
        "outcome": "completed",
        "match": "exact",
        "calls": [
          {
            "name": "get_product",
            "arguments": {
              "application_id": "app_test_shop",
              "product_id": "prod_test_tote"
            },
            "argument_match": "exact",
            "tool_outcome": "success"
          },
          {
            "name": "create_checkout",
            "arguments": {
              "application_id": "app_test_shop",
              "product_id": "prod_test_tote",
              "price_id": "price_test_standard",
              "quantity": 2,
              "destination_country": "GH",
              "operation_key": "op_test_checkout_001"
            },
            "argument_match": "exact",
            "tool_outcome": "success"
          }
        ],
        "forbidden_tools": [],
        "max_calls": 2
      },
      "reason": "Checkout must hydrate current source-owned data and preserve the shopper's exact selection."
